{
  "$description": "管理后台系统概况。2026-11-23 从已登录的 dashboard 计算样式抽出。不含账号、不含站点名。",
  "color": {
    "primary": { "$type": "color", "$value": "#1677ff" },
    "primary-hover": { "$type": "color", "$value": "#4096ff" },
    "brand": { "$type": "color", "$value": "#ff6a00" },
    "background": { "$type": "color", "$value": "#f5f5f5" },
    "surface": { "$type": "color", "$value": "#ffffff" },
    "bar-product": { "$type": "color", "$value": "#ff6b1a" },
    "bar-floor": { "$type": "color", "$value": "#3d7eff" },
    "bar-banner": { "$type": "color", "$value": "#8b5cf6" },
    "bar-news": { "$type": "color", "$value": "#1bbf75" }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": "-apple-system, BlinkMacSystemFont, PingFang SC, Helvetica Neue, Microsoft YaHei, Noto Sans SC, sans-serif"
    },
    "body": { "$type": "dimension", "$value": "14px" },
    "hero": { "$type": "dimension", "$value": "22px" }
  },
  "size": {
    "header": { "$type": "dimension", "$value": "56px" },
    "sider": { "$type": "dimension", "$value": "216px" },
    "menu-item": { "$type": "dimension", "$value": "40px" },
    "bar": { "$type": "dimension", "$value": "22px" }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "12px" },
    "shell": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "20px" }
  },
  "semantic": {
    "color": {
      "primary": { "$type": "color", "$value": "{color.primary}" },
      "brand": { "$type": "color", "$value": "{color.brand}" },
      "background": { "$type": "color", "$value": "{color.background}" },
      "surface": { "$type": "color", "$value": "{color.surface}" }
    },
    "font": {
      "body": { "$type": "fontFamily", "$value": "{font.sans}" }
    }
  }
}
