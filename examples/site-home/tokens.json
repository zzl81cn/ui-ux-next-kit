{
  "$description": "官网首页。2026-11-23 从桌面视口计算样式抽出。不含站点名。",
  "color": {
    "orange": { "$type": "color", "$value": "#ff6a00" },
    "orange-hover": { "$type": "color", "$value": "#e56200" },
    "white": { "$type": "color", "$value": "#ffffff" },
    "black": { "$type": "color", "$value": "#000000" },
    "text-secondary": { "$type": "color", "$value": "#333333" },
    "floor": { "$type": "color", "$value": "#f5f5f7" },
    "header-border": { "$type": "color", "$value": "#f3f4f6" }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": "-apple-system, BlinkMacSystemFont, PingFang SC, Helvetica Neue, Microsoft YaHei, Noto Sans SC, sans-serif"
    },
    "nav": { "$type": "dimension", "$value": "14px" },
    "body": { "$type": "dimension", "$value": "16px" },
    "title": { "$type": "dimension", "$value": "36px" }
  },
  "size": {
    "content": { "$type": "dimension", "$value": "1200px" },
    "card": { "$type": "dimension", "$value": "590px" },
    "header": { "$type": "dimension", "$value": "56px" },
    "banner": { "$type": "dimension", "$value": "720px" },
    "hero-card": { "$type": "dimension", "$value": "520px" },
    "button": { "$type": "dimension", "$value": "40px" }
  },
  "radius": {
    "nav": { "$type": "dimension", "$value": "4px" },
    "card": { "$type": "dimension", "$value": "24px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "semantic": {
    "color": {
      "primary": { "$type": "color", "$value": "{color.orange}" },
      "on-primary": { "$type": "color", "$value": "{color.white}" },
      "background": { "$type": "color", "$value": "{color.white}" },
      "surface-floor": { "$type": "color", "$value": "{color.floor}" },
      "text": { "$type": "color", "$value": "{color.black}" },
      "footer": { "$type": "color", "$value": "{color.black}" }
    },
    "font": {
      "heading": { "$type": "fontFamily", "$value": "{font.sans}" },
      "body": { "$type": "fontFamily", "$value": "{font.sans}" }
    }
  }
}
